#!/usr/bin/env bash
set -euo pipefail

TOOL_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Keep this legacy command path stable while new internal components follow the
# repository's gosterme naming convention.
source "${TOOL_DIR}/gosterme/common.sh"
source "${TOOL_DIR}/gosterme/staging.sh"
source "${TOOL_DIR}/gosterme/production.sh"
source "${TOOL_DIR}/gosterme/application.sh"

usage() {
    cat <<'EOF'
Usage:
  tools/goster stage <ref>
  tools/goster stage-status
  tools/goster stage-test
  tools/goster prod-preflight
  tools/goster prod-status
  tools/goster analytics [--since-hours N | --since-milestone NAME] [--campaign NAME]
                         [--exclude-ip ADDRESS | --exclude-current-ssh-client]
  tools/goster feedback list [--status unread|reviewed|all] [--limit N]
  tools/goster feedback ack <receipt>
  tools/goster feedback purge
  tools/goster feedback notify
  tools/goster unsupported list [--limit N]
  tools/goster unsupported purge

This first deployment-workflow increment is intentionally read-mostly for production.
It prepares and validates exact-SHA staging worktrees and verifies production state.
Production mutation commands (deploy-main / rollback) are added only after this state
model is validated on the real host.
EOF
}

main() {
    local command="${1:-}"
    shift || true

    case "$command" in
        stage)
            cmd_stage "$@"
            ;;
        stage-status)
            cmd_stage_status
            ;;
        stage-test)
            cmd_stage_test
            ;;
        prod-preflight)
            cmd_prod_preflight
            ;;
        prod-status)
            cmd_prod_status
            ;;
        analytics)
            cmd_analytics "$@"
            ;;
        feedback)
            cmd_feedback "$@"
            ;;
        unsupported)
            cmd_unsupported "$@"
            ;;
        -h|--help|help|"")
            usage
            ;;
        *)
            die "unknown command: $command"
            ;;
    esac
}

main "$@"
