[Unit]
Description=Deliver pending goster.me feedback to Telegram
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=gosterme
Group=gosterme
WorkingDirectory=/opt/goster.me
EnvironmentFile=/etc/goster.me/gosterme.env
ExecStart=/opt/goster.me/.venv/bin/python /opt/goster.me/feedback_telegram.py

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/goster.me

MemoryMax=96M
TasksMax=16
LimitNOFILE=128
CPUQuota=50%

UMask=0027
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
