# Example hardening snippets for the public goster.me reverse proxy.
# Merge these directives into the production nginx configuration during staging.

limit_req_zone $binary_remote_addr zone=goster_resolve:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=goster_general:10m rate=60r/m;

server {
    # Existing listen/server_name/TLS directives go here.

    client_max_body_size 4k;

    location = /resolve {
        limit_req zone=goster_resolve burst=3 nodelay;

        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 20s;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_pass http://127.0.0.1:8090;
    }

    location / {
        limit_req zone=goster_general burst=20 nodelay;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_pass http://127.0.0.1:8090;
    }
}
