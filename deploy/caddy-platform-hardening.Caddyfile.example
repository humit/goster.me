# Merge these directives into the existing production Caddyfile; do not
# replace the current scanner-path deny rules or access logging blindly.

# Main public origin additions.
goster.me {
    header {
        -Server
        -X-Powered-By
        -Alt-Svc

        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https:; media-src 'self' blob: https:; connect-src 'self' https:; frame-src https:; upgrade-insecure-requests"
    }

    encode zstd gzip
    reverse_proxy 127.0.0.1:8090
}

# Dedicated untrusted-content origin. The backend emits its own CSP with
# frame-ancestors https://goster.me and CSP sandbox restrictions.
sandbox.goster.me {
    header {
        -Server
        -X-Powered-By
        -Alt-Svc
    }

    encode zstd gzip
    reverse_proxy 127.0.0.1:8092
}
