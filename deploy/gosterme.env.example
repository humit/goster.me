# Runtime bind. Caddy proxies the public HTTPS origin to this listener.
GOSTER_HOST=127.0.0.1
GOSTER_PORT=8090

# Persistent short-link store.
GOSTER_DATABASE=/var/lib/goster.me/goster.sqlite3

# Default short-link lifetime: 14 days.
GOSTER_LINK_TTL_SECONDS=1209600

# Human-friendly short-code length.
GOSTER_SHORT_CODE_LENGTH=6
